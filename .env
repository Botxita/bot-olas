# ==========================================
# CACHÉ
# ==========================================
# TTL del caché de forecasts en segundos (default: 1800 = 30 min)
FORECAST_CACHE_TTL_SECONDS=1800

# Redis (opcional, para multi-instancia)
# REDIS_URL=rediss://usuario:password@host:6380

